# Port the seller listens on
PORT=3100

# Facilitator this server settles through (our Arbitrum facilitator fork)
FACILITATOR_URL=http://localhost:3002
# Merchant API key registered on the facilitator (sent only on /settle)
MERCHANT_API_KEY=
# CAIP-2 network the facilitator settles on. eip155:421614 = Arbitrum Sepolia
NETWORK=eip155:421614
# Price per analysis call in USD. Must exceed the facilitator's 0.10 USDC gas floor.
PRICE_USD=0.25

# Data sources for the analysis itself (always Arbitrum One mainnet, read-only)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Etherscan V2 API key (works for Arbiscan with chainid=42161). Free at https://arbiscan.io/myapikey
ARBISCAN_API_KEY=

# Only used by `npm run agent`: buyer wallet funded with test USDC on the NETWORK above
BUYER_PRIVATE_KEY=

# Nota attestation (Arbitrum Sepolia, chain id 421614). After each settled call the seller
# publishes attestReceipt, an on-chain commitment to the exact bytes it returned.
# Deployment record: notaxyz/contracts deployments/arbitrum-sepolia-attest.json
#   NotaReceiptStore    0x6b13e2077c84e1326111acBbb618E028723e2EA2
#   PurchaseRefRegistry 0x32aAeC7768adBBFD65C776b129616b8727d0c8bd
# Arbitrum Sepolia RPC, used by the seller to attest and by `npm run verify` to read logs
NOTA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NOTA_RECEIPT_STORE=0x6b13e2077c84e1326111acBbb618E028723e2EA2
NOTA_PURCHASE_REF_REGISTRY=0x32aAeC7768adBBFD65C776b129616b8727d0c8bd
# Listing on NOTA_RECEIPT_STORE whose seller is SELLER_PRIVATE_KEY's address
NOTA_LISTING_ID=1
# Seller key that signs attestReceipt. Needs Arbitrum Sepolia ETH for gas. Moves no USDC.
SELLER_PRIVATE_KEY=

# Buyer side (`npm run verify`, `npm run agent`): the seller address you expect to have bought from
NOTA_EXPECTED_SELLER=
